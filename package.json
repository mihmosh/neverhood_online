{
  "name": "neverhood-online",
  "description": "Play your own copy of The Neverhood in your browser with local-only game import.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": { "type": "git", "url": "git+https://github.com/mihmosh/neverhood_online.git" },
  "bugs": { "url": "https://github.com/mihmosh/neverhood_online/issues" },
  "homepage": "https://neverhood-online.vercel.app",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node server.mjs",
    "build": "node scripts/build-site.mjs",
    "preview": "node server.mjs --dist",
    "build:runtime": "bash scripts/build-runtime.sh",
    "build:demo-data": "node scripts/build-demo-data.mjs",
    "build:demo-runtime": "bash scripts/build-demo-runtime.sh",
    "build:demo-cursor": "node scripts/build-demo-cursor.mjs",
    "prepare:demo": "node scripts/prepare-demo-release.mjs",
    "prepare:demo-previews": "node scripts/prepare-demo-previews.mjs",
    "build:extractor": "bash scripts/build-extractor.sh",
    "package:sources": "node scripts/package-sources.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "capture:ui": "node scripts/capture-ui.mjs",
    "prototype:abi": "node scripts/generate-render-abi.mjs",
    "assets:audit": "node scripts/check-private-assets.mjs",
    "assets:extract": "node scripts/assets-extract.mjs",
    "assets:associate": "node scripts/assets-associate.mjs",
    "assets:map": "node scripts/assets-map.mjs",
    "evaluation:inputs": "node tools/evaluation/prepare-inputs.mjs",
    "evaluation:inventory": "node tools/evaluation/manifest.mjs",
    "evaluation:verify": "node tools/evaluation/manifest.mjs --verify",
    "evaluation:bundle": "node tools/evaluation/manifest.mjs --bundle",
    "evaluation:references": "node tools/evaluation/reference-leads.mjs",
    "vendor:zip": "node scripts/vendor-zip.mjs",
    "vendor:font": "node scripts/vendor-menu-font.mjs",
    "test": "node --test test/*.test.mjs web/test/*.test.mjs"
  }
}
